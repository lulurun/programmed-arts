[Unit]
Description=Programmed Arts API Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/lulurun/workspace/conversation-art-repo
Environment=PATH=/home/lulurun/.pyenv/versions/3.13.9/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/lulurun/.pyenv/versions/3.13.9/bin/python server.py
Restart=always
RestartSec=10
StandardOutput=append:/panda-infra/programmed-arts/api.log
StandardError=append:/panda-infra/programmed-arts/api.log

[Install]
WantedBy=default.target
